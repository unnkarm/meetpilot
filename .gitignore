# ==============================================================================
# MeetPilot AI - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# Node / Frontend (React / Vite / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.eslintcache
.parcel-cache
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ------------------------------------------------------------------------------
# Python / Backend (FastAPI / Celery / SQLAlchemy / Pytest)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
pythonenv/

# Testing & Linting
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.mypy_cache/
.pytype/
.ruff_cache/
.hypothesis/

# Celery
celerybeat-schedule
celerybeat-schedule.db
celerybeat.pid

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal

# Local upload / processed audio & transcript storage
storage/*
backend/storage/*
!backend/storage/.gitkeep
!storage/.gitkeep

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.bak
