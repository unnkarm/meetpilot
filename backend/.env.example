# --- Database ---
DATABASE_URL=postgresql+psycopg2://meetpilot:meetpilot@postgres:5432/meetpilot
# Sync URL used by Alembic / psycopg2. SQLAlchemy engine also uses this directly.

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Clerk Auth ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
# Optional when CLERK_JWKS_URL uses the exact Frontend API pattern above.
# The backend derives and validates the issuer from that URL when omitted.
CLERK_ISSUER_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev


# --- Optional legacy remote transcription only ---
GEMINI_API_KEY=

# --- Hugging Face ZeroGPU Space (Self-Hosted Whisper + PyAnnote Diarization) ---
HF_SPACE_ID=Subham05x/meetpilot-whisper-diarization
HF_API_TOKEN=
HF_SPACE_TIMEOUT_SECONDS=600

# --- Development inference defaults (production targets hosted OpenAI APIs) ---
AI_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Later: select AI_PROVIDER=openai, set an account-available OPENAI_CHAT_MODEL
# and a server-only key. Never use VITE_ for this key. Restart API and workers.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
# Embeddings can migrate separately from chat; reindex ALL source vectors first.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=base
TRANSCRIPTION_PROVIDER=local
DEFAULT_LANGUAGE=auto
ENABLE_LANGUAGE_DETECTION=true
MULTILINGUAL_TRANSCRIPTION=true
MULTILINGUAL_LLM=true
MULTILINGUAL_EMBEDDINGS=true
RAG_CROSS_LANGUAGE=true
SUMMARY_LANGUAGE_MODE=meeting
QA_LANGUAGE_MODE=question
LANGUAGE_MIN_CONFIDENCE=0.55
RAG_MAX_COSINE_DISTANCE=0.70
PILOT_CONTEXT_WINDOW=20
PILOT_ENABLED=true
PILOT_OBSERVABILITY_ENABLED=true
PILOT_WAKE_WORD=Hey Pilot
PILOT_STT_PROVIDER=faster_whisper
# Increase to 900-1200 if natural pauses end your microphone question too early.
PILOT_SILENCE_END_MS=700
PILOT_DIARIZATION_PROVIDER=single_speaker
PILOT_WAKEWORD_PROVIDER=transcript_phrase
PILOT_TTS_PROVIDER=piper
# Optional local voice model override (the Docker image bundles en_US-lessac-medium).
# PILOT_PIPER_VOICE_PATH=/app/voices/en_US-lessac-medium.onnx
# Optional, preinstalled native neural voices (matching .onnx.json required).
# Bengali/Hindi otherwise use local espeak-ng; no runtime model download.
# PILOT_PIPER_HI_VOICE_PATH=/app/voices/hi_voice.onnx
# PILOT_PIPER_BN_VOICE_PATH=/app/voices/bn_voice.onnx
PILOT_AUDIO_PROVIDER=vexa
PILOT_TTS_ENABLED=true
PILOT_MEMORY_ENABLED=true
PILOT_MEMORY_CONFIDENCE_THRESHOLD=0.85
PILOT_IDENTITY_CONFIDENCE_THRESHOLD=0.90

# --- Local storage is configured in app/core/app_config.py ---
# Vexa service endpoints and private tokens are generated separately in
# backend/.env.vexa by: python backend/scripts/setup_vexa.py

# --- ZOOM ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/oauth/zoom/callback


# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
