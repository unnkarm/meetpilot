# --- Database ---
DATABASE_URL=postgresql+psycopg2://meetpilot:meetpilot@postgres:5432/meetpilot
# Sync URL used by Alembic / psycopg2. SQLAlchemy engine also uses this directly.

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Clerk Auth ---
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev


# --- Google Gemini ---
# Used for transcription (audio understanding), summary/task/decision extraction,
# embeddings (semantic search) and meeting chat.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Storage ---
# Local disk storage for MVP. Swap for S3 later without changing calling code
# (see app/services/storage.py).
STORAGE_DIR=/app/storage

# --- ZOOM ---
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/oauth/zoom/callback

# --- Vexa.ai Self-Hosted Live Capture ---
VEXA_API_URL=http://127.0.0.1:18056
VEXA_WS_URL=ws://127.0.0.1:18056/ws
VEXA_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
