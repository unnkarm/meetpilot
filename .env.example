# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+psycopg2://meetpilot:meetpilot@postgres:5432/meetpilot

# --- Redis & Distributed Celery Workers ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Authentication (Clerk JWKS / Bearer Token Verification) ---
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER_URL=https://<your-clerk-frontend-api>.clerk.accounts.dev

# --- Google Gemini AI (Configurable Quota Limits) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_AUDIO_MODEL=gemini-3.5-flash
GEMINI_RPM_LIMIT=15
GEMINI_TPM_LIMIT=1000000
GEMINI_RPD_LIMIT=1500

# --- Zero-Cost Local Inference Engines ---
USE_LOCAL_WHISPER=true
USE_LOCAL_EMBEDDINGS=true

# --- Hugging Face ZeroGPU Space (Self-Hosted Whisper + PyAnnote Diarization) ---
HF_SPACE_ID=Subham05x/meetpilot-whisper-diarization
HF_API_TOKEN=
HF_SPACE_TIMEOUT_SECONDS=600

# --- Audio & File Storage ---
STORAGE_DIR=/app/storage

# --- CORS Settings ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Third-Party Integrations & Fernet AES Encryption at Rest ---
ENCRYPTION_SECRET_KEY=meetpilot-super-fernet-secret-32-chars-long!
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/oauth/zoom/callback
